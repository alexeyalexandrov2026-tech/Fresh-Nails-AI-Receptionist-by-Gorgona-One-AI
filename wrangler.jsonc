{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fresh-nails-ai-receptionist-by-gorgona-one-ai",
  "compatibility_date": "2026-08-07",
  "main": ".open-next/worker.js",
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "fresh-nails-ai-receptionist-by-gorgona-one-ai"
    }
  ]
}
